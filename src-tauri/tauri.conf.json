{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyClick",
  "version": "1.0.0",
  "identifier": "com.keyclick.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "KeyClick",
        "width": 460,
        "height": 760,
        "minWidth": 400,
        "minHeight": 560,
        "resizable": true,
        "maximizable": false,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#0d0e11"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg"],
    "publisher": "KeyClick",
    "copyright": "Copyright © 2026 KeyClick",
    "category": "Utility",
    "shortDescription": "Make typing sound satisfying.",
    "longDescription": "KeyClick plays short keyboard sounds while you type. It works alongside your existing keyboard, never records what you type and works fully offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "sounds/": "sounds/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "KeyClick"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "signingIdentity": "-",
      "dmg": {
        "windowSize": { "width": 540, "height": 380 },
        "appPosition": { "x": 140, "y": 180 },
        "applicationFolderPosition": { "x": 400, "y": 180 }
      }
    }
  }
}
